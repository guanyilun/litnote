#!/usr/bin/env bash
# Start a literate project from the template.
#
#   litnote-new DIR [TITLE]
#
# Creates independent explanatory notes and working analyses.

set -euo pipefail
[ $# -ge 1 ] || { sed -n '2,7p' "$0"; exit 2; }
LITNOTE=$(cd "$(dirname "$(realpath "$0")")/.." && pwd)
mkdir -p "$1"
PROJ=$(cd "$1" && pwd)
NAME=$(basename "$PROJ")
TITLE=${2:-$NAME}
DATE=$(date +%F)
for folder in note analysis notes; do
  [ ! -e "$PROJ/$folder" ] || { echo "litnote-new: $PROJ/$folder already exists" >&2; exit 1; }
done
mkdir -p "$PROJ"/{note,analysis,bin,src,scripts,diagrams,out}
fill() { sed -e "s#@NAME@#$NAME#g" -e "s#@TITLE@#$TITLE#g" -e "s#@DATE@#$DATE#g" -e "s#@PROJ@#$PROJ#g" -e "s#@LITNOTE@#$LITNOTE#g" "$1" > "$2"; }
fill "$LITNOTE/template/Makefile"               "$PROJ/Makefile"
cp "$LITNOTE/template/diagrams/weighted-mean.svg" "$PROJ/diagrams/weighted-mean.svg"
fill "$LITNOTE/template/readme.org"             "$PROJ/readme.org"
fill "$LITNOTE/template/note/NAME.org"          "$PROJ/note/$NAME.org"
fill "$LITNOTE/template/analysis/NAME.org"      "$PROJ/analysis/$NAME.org"
[ -e "$PROJ/CLAUDE.md" ] || fill "$LITNOTE/template/CLAUDE.md" "$PROJ/CLAUDE.md"
ln -s "$LITNOTE/bin/note" "$PROJ/bin/note"
[ -e "$PROJ/.gitignore" ] || cp "$LITNOTE/template/gitignore" "$PROJ/.gitignore"
echo "created $PROJ (litnote $(git -C "$LITNOTE" describe --always --dirty 2>/dev/null))"
echo "  make tangle            write the example's script"
echo "  mkdir -p out/example && python bin/example.py > out/example/example.txt"
echo "  make                   render individual documents under out/notes/"
echo "  bin/note start         notes daemon"
